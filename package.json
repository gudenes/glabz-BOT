{
  "name": "glabs-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Glabs Bot — multi-product multi-tenant WhatsApp (Baileys) channel for GLabs apps.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:llm": "tsx --test test/llm/*.test.ts",
    "test:ui": "tsx --test test/ui/*.test.ts",
    "test:db": "tsx --test test/db/*.test.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "pino": "^9.5.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": ">=22",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "puppeteer-core": "^24.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
